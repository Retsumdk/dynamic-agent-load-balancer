{
  "name": "dynamic-agent-load-balancer",
  "description": "Intelligently distributes tasks across an agent fleet based on real-time capacity, specialization, and performance metrics",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Retsumdk",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "agent",
    "load-balancer",
    "scheduler",
    "task-queue",
    "fleet",
    "concurrency",
    "multi-agent",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dalb": "./dist/cli-run.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "demo": "bun src/demo.ts",
    "prepare": "tsc"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.4.0"
  }
}
